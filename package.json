{
  "name": "@local/dsh-openai-image",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Generate and edit reference images in normal DSH conversations, with model capability tooltips.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/NL02040616/dsh-openai-image.git" },
  "homepage": "https://github.com/NL02040616/dsh-openai-image#readme",
  "bugs": { "url": "https://github.com/NL02040616/dsh-openai-image/issues" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
