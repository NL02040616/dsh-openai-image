{
  "name": "@local/dsh-openai-image",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "One-shot image creation, visible references and edit-again actions in DSH conversations.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/NL02040616/dsh-openai-image.git" },
  "homepage": "https://github.com/NL02040616/dsh-openai-image#readme",
  "bugs": { "url": "https://github.com/NL02040616/dsh-openai-image/issues" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "sizing.js", "one-shot.js", "client.js", "transport.js", "windows-request.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.mjs", "build:client": "node scripts/build-client.mjs", "check:client": "node scripts/build-client.mjs --check" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-attachment", "@deepseek-ai/dsh-client-ui-input-trigger", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-commands"]
    }
  }
}
